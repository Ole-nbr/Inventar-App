APP_NAME=Inventar-App
ENVIRONMENT=development
DEBUG=false

# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=inventar
POSTGRES_PASSWORD=changeme
POSTGRES_DB=inventar
POSTGRES_PORT=5432

# Must match the POSTGRES_* values above
DATABASE_URL=postgresql+psycopg://inventar:changeme@localhost:5432/inventar
